includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    phpVersion: 80401
    paths:
        - packages/fixed-term-access
        - packages/stack-theme
        - tools/stack-verify
        - tests/php
    excludePaths:
        - tools/stack-verify/stubs
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - tools/stack-verify/stubs/wp-cli.stub.php
